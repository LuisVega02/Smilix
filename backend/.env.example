# ============================================================
# ENTORNO - Ambiente de ejecución
# ============================================================
NODE_ENV=development

# ============================================================
# BASE DE DATOS - Configuración PostgreSQL
# ============================================================
# La URL de conexión se construye automáticamente en docker-compose.yml
# Para desarrollo local sin Docker, usa:
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/clinic_db
DATABASE_URL=postgresql://clinicuser:clinicpass123@postgres:5432/clinic_db

# Usuario de la base de datos
DB_USER=clinicuser

# Contraseña de la base de datos
DB_PASSWORD=clinicpass123

# Nombre de la base de datos
DB_NAME=clinic_db

# ============================================================
# SEGURIDAD - JWT y autenticación
# ============================================================
# Clave secreta para firmar JWT tokens
# IMPORTANTE: Cambiar en producción a una cadena larga y aleatoria
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345

# Tiempo de expiración de los tokens (ej: 7d, 24h)
JWT_EXPIRATION=7d

# ============================================================
# API - Configuración del servidor
# ============================================================
# Puerto en el que escucha la API
PORT=3001

# ============================================================
# CORS - Configuración de origen
# ============================================================
# Orígenes permitidos para CORS (separados por comas si hay múltiples)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# ============================================================
# LOGGING - Nivel de registros
# ============================================================
# Niveles: error, warn, log, debug, verbose
LOG_LEVEL=debug

# ============================================================
# pgAdmin - Credenciales de acceso a http://localhost:5050
# ============================================================
PGADMIN_EMAIL=admin@clinic.com
PGADMIN_PASSWORD=admin123
