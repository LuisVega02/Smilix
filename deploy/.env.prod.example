# ============================================================
# Smilix — variables de despliegue (QA/Producción en RPi 3B+)
# Copia este archivo como .env.prod y rellena los valores.
# NO subas .env.prod a Git.
# ============================================================

# --- Tailscale ---
# Hostname con el que aparecerá el servidor en tu tailnet (MagicDNS).
TS_HOSTNAME=smilix
# Auth key de Tailscale (Settings -> Keys -> Generate auth key).
# Recomendado: key efímera/preautorizada y, si usas tags, --advertise-tags.
TS_AUTHKEY=tskey-auth-REEMPLAZAR

# --- Base de datos ---
DB_USER=clinicuser
# Usa una contraseña fuerte y sin caracteres que rompan la URL (o codifícala).
DB_PASSWORD=REEMPLAZAR-contraseña-fuerte
DB_NAME=clinic_db

# --- Backend ---
# Secreto JWT largo y aleatorio (obligatorio: el backend no arranca sin él).
JWT_SECRET=REEMPLAZAR-secreto-largo-aleatorio
JWT_EXPIRATION=7d

# --- Frontend / CORS ---
# URL con la que el navegador del cliente llega al backend por Tailscale.
NEXT_PUBLIC_API_URL=http://smilix:3001
# Origen permitido por CORS (el frontend por Tailscale).
CORS_ORIGIN=http://smilix:3000
