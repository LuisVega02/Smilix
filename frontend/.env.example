# ============================================================
# ENTORNO - Ambiente de ejecución
# ============================================================
NODE_ENV=development

# ============================================================
# API - URL del backend
# ============================================================
# Esta variable es pública (accesible desde el navegador)
# En producción, cambiar al dominio o IP del servidor backend
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================================
# CONFIGURACIÓN DE BUILD
# ============================================================
# Modo de desarrollo o producción
# development: Incluye source maps y hot-reload
# production: Optimizado y minificado
NEXT_ENV_MODE=development

# ============================================================
# Configuración personalizada de la clínica (opcional)
# ============================================================
NEXT_PUBLIC_CLINIC_NAME=Clínica Dental Sistema
NEXT_PUBLIC_CLINIC_VERSION=2.0.0
